# Environment Configuration - AsistaApp Backend
# Copy this file as .env and fill in your values.
# DO NOT commit .env to version control.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_SERVER_IP

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key

# Database (MySQL)
DB_NAME=AsistaApp
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
